<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#00FCFEFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="150dp"
        android:layout_height="198dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="47dp"
        android:background="@drawable/shape_item_catalog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

<!--        <ImageButton-->
<!--            android:id="@+id/favButton"-->
<!--            android:layout_width="24dp"-->
<!--            android:layout_height="24dp"-->
<!--            android:layout_marginEnd="4dp"-->
<!--            android:background="@android:color/transparent"-->
<!--            android:src="@drawable/ic_heart_unselected"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            app:layout_constraintTop_toTopOf="parent" />-->

        <CheckBox
            android:id="@+id/favButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"

            style="@style/Base.Widget.Material3.CompoundButton.CheckBox.CustomCheckBox"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <LinearLayout
            android:layout_width="93dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="29dp"
            android:layout_marginEnd="28dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/articleTextView"
                style="@style/MotserratText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="5060068"
                android:textSize="10sp" />


            <ImageView
                android:id="@+id/productImageView"
                android:layout_width="93dp"
                android:layout_height="93dp"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/dimensionsTextView"
                style="@style/MotserratText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="ш*в*г - 80*200*40"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/priceTextView"
                style="@style/MotserratText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="цена: 15000₽"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/nameTextView"
                style="@style/MotserratText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="шкаф белый"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <Button
                android:id="@+id/buyButton"
                style="@style/ButtonStyle"
                android:layout_width="95dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="7dp"
                android:text="@string/buy"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>