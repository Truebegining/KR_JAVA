<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authFragment">

    <fragment
        android:id="@+id/catalogFragment"
        android:name="com.example.kr_kotlin.ui.catalog_java.CatalogFragment"
        android:label="fragment_catalog"
        tools:layout="@layout/fragment_catalog" >
        <action
            android:id="@+id/action_catalogFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_catalogFragment_to_subCatalogFragment"
            app:destination="@id/subCatalogFragment" >
            <argument
                android:name="category"
                app:argType="string"
                android:defaultValue="@null"
                app:nullable="true">
            </argument>

            <argument
                android:name="search"
                app:argType="string"
                android:defaultValue="@null"
                app:nullable="true">
            </argument>
        </action>
    </fragment>
    <fragment
        android:id="@+id/productCardFragment"
        android:name="com.example.kr_kotlin.ui.productCard_java.ProductCardFragment"
        android:label="ProductCardFragment"
        tools:layout="@layout/fragment_product_card" >
        <argument
            android:name="product"
            app:argType="com.example.kr_kotlin.ui.sub_catalog_java.Product"/>
        <action
            android:id="@+id/action_productCardFragment_to_cartFragment"
            app:destination="@id/cartFragment">
        </action>
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.kr_kotlin.ui.profile_java.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_authFragment"
            app:destination="@id/authFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:id="@+id/subCatalogFragment"
        android:name="com.example.kr_kotlin.ui.sub_catalog_java.SubCatalogFragment"
        android:label="SubCatalogFragment"
        tools:layout="@layout/fragment_sub_catalog" >
        <argument
            android:name="category"
            app:argType="string"
            android:defaultValue="@null"
            app:nullable="true">
        </argument>

        <argument
            android:name="search"
            app:argType="string"
            android:defaultValue="@null"
            app:nullable="true">
        </argument>
        <action
            android:id="@+id/action_subCatalogFragment_to_productCardFragment"
            app:destination="@id/productCardFragment">
            <argument
                android:name="product"
                app:argType="com.example.kr_kotlin.ui.sub_catalog_java.Product"/>
        </action>
    </fragment>
    <fragment
        android:id="@+id/cartFragment"
        android:name="com.example.kr_kotlin.ui.cart_java.CartFragment"
        android:label="CartFragment"
        tools:layout="@layout/fragment_cart" >
        <action
            android:id="@+id/action_cartFragment_to_productCardFragment"
            app:destination="@id/productCardFragment" >
            <argument
                android:name="product"
                app:argType="com.example.kr_kotlin.ui.sub_catalog_java.Product"/>
        </action>
    </fragment>
    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.kr_kotlin.ui.favorites_java.FavoritesFragment"
        android:label="fragment_favorites"
        tools:layout="@layout/fragment_favorites" >
        <action
            android:id="@+id/action_favoritesFragment_to_productCardFragment"
            app:destination="@id/productCardFragment">
            <argument
                android:name="product"
                app:argType="com.example.kr_kotlin.ui.sub_catalog_java.Product">
            </argument>
        </action>
    </fragment>
    <fragment
        android:id="@+id/registrFragment"
        android:name="com.example.kr_kotlin.ui.registration_java.RegistrFragment"
        android:label="RegistrFragment" >
        <action
            android:id="@+id/action_registrFragment_to_authFragment"
            app:destination="@id/authFragment" />
    </fragment>
    <fragment
        android:id="@+id/authFragment"
        android:name="com.example.kr_kotlin.ui.authorization_java.AuthFragment"
        android:label="AuthFragment" >
        <action
            android:id="@+id/action_authFragment_to_catalogFragment"
            app:destination="@id/catalogFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_authFragment_to_registrFragment"
            app:destination="@id/registrFragment" />
    </fragment>
</navigation>